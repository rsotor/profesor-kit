# Copias de las skills: la única fuente es .kit/skills/ (las regenera instalar-skills.js)
.claude/skills/
.agents/skills/
.codex/skills/

# El sí del alumno a los permisos (permisos.js): es de este ordenador, no del curso ni del motor.
**/.claude/settings.local.json
.codex/config.toml
.codex/rules/profesor-kit.rules

# Secretos: nunca entran en el repo
.env
.env.*
*.pem
*.key

# Obsidian: la disposición de ventanas cambia cada vez que se abre un fichero; no se guarda.
# (La documentación oficial recomienda ignorar workspace.json y workspaces.json.)
**/.obsidian/workspace*.json
**/.obsidian/cache

# Complementos de la comunidad: código de terceros que descarga obsidian.js. No entran en el repo.
# community-plugins.json es la lista de los ACTIVADOS: activarlos es decisión del alumno, nunca del kit.
**/.obsidian/plugins/
**/.obsidian/community-plugins.json

# Banco de pruebas del kit: cursos de usar y tirar para probar instalaciones. Nunca se sube.
pruebas-local/

# Copias de trabajo de preparar.js (una por clase en preparación en segundo plano): cada una es su
# propio git worktree, en su propia rama preparacion/<id>. Se borran solas al juntar con --juntar.
.preparacion/

# Linter del repo del kit (dev): preparar-curso.js ya borra eslint.config.js en los cursos
node_modules/

# Sistema
.DS_Store
Thumbs.db
*.tmp
*~
